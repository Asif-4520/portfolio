# Copy this file to .env.local and add credentials.
# Keep .env.local private and never commit real tokens.

# Discord incoming webhook
DISCORD_WEBHOOK_URL=

# Telegram bot credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Optional generic webhook. Receives JSON with content, text, contact, and source.
CONTACT_WEBHOOK_URL=

//optional Discord avatar URL for notifications. If not set, defaults to GitHub avatar.
DISCORD_AVATAR_URL=